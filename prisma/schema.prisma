generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  categoryId   Int        @id @default(autoincrement())
  categoryName String     @db.VarChar(100)
  description  String?
  Resource     Resource[]
}


model Reservation {
  reservationId Int      @id @default(autoincrement())
  userId        Int
  resourceId    Int
  startTime     DateTime @db.Timestamp(6)
  endTime       DateTime @db.Timestamp(6)
  status        String   @default("PENDING") @db.VarChar(20)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  Resource      Resource @relation(fields: [resourceId], references: [resourceId], onDelete: NoAction, onUpdate: NoAction)
  User          User     @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
}

model Resource {
  resourceId   Int           @id @default(autoincrement())
  name         String        @db.VarChar(150)
  description  String?
  resourceType String        @db.VarChar(50)
  location     String        @db.VarChar(255)
  capacity     Int
  status       String        @default("AVAILABLE") @db.VarChar(20)
  categoryId   Int
  Reservation  Reservation[]
  Category     Category      @relation(fields: [categoryId], references: [categoryId], onDelete: NoAction, onUpdate: NoAction)
}

model User {
  userId       Int           @id @default(autoincrement())
  fullName     String        @db.VarChar(100)
  email        String        @unique @db.VarChar(255)
  passwordHash String
  role         String        @default("USER") @db.VarChar(20)
  createdAt    DateTime      @default(now()) @db.Timestamp(6)
  Reservation  Reservation[]
}
